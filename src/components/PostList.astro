---
import { getCollection } from 'astro:content';

// Newest first. With no posts the component renders nothing at all, so the
// landing does not grow an empty heading before the first article ships.
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

{
  posts.length > 0 && (
    <section class="posts" id="writing" aria-labelledby="posts-heading">
      <h2 class="posts-heading" id="posts-heading">
        Writing
      </h2>
      <ul class="posts-list">
        {posts.map((post) => (
          <li class="post">
            <h3 class="post-title">
              {/* Click tracking rides the same count.js attributes the profile
                  buttons use, so this needs no script and leaves the CSP hash
                  untouched. */}
              <a
                href={`/articles/${post.id}/`}
                data-goatcounter-click={`post-${post.id}`}
                data-goatcounter-title={`Post: ${post.data.title}`}
              >
                {post.data.title}
              </a>
            </h3>
            <p class="post-date">
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {formatDate(post.data.date)}
              </time>
            </p>
            <p class="post-description">{post.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}
