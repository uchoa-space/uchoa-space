---
import Starfield from '../components/Starfield.astro';
import ShareMeta from '../components/ShareMeta.astro';
import { ogImageAlt } from '../lib/og-image';

interface Props {
  title: string;
  description: string;
  date: Date;
  readingTime: string;
  /** MDX filename stem, which is also the route slug and the card's basename. */
  slug: string;
  /** The post's own card description, when it has a card of its own. */
  imageAlt?: string;
}

const { title, description, date, readingTime, slug, imageAlt } = Astro.props;

// The frontmatter date is a bare YYYY-MM-DD, which parses as UTC midnight;
// formatting in UTC keeps it from sliding a day west of Greenwich.
const isoDate = date.toISOString().slice(0, 10);
const readableDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Rafael Uchoa</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <!--
      Same deny-by-default CSP as the landing, with one difference: `style-src`
      here allows inline styles. Shiki writes syntax colours as a `style`
      attribute on every token span, and a CSP hash cannot cover style
      attributes (only `'unsafe-hashes'` can, and `style-src-attr` is not
      honoured by every browser, so a stricter spelling would silently drop the
      highlighting in Safari). No inline style block and no inline script exist
      on this page: the stylesheet and count.js are both same-origin files.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://uchoa-space.goatcounter.com; connect-src https://uchoa-space.goatcounter.com; base-uri 'none'; form-action 'none'; object-src 'none'"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%23030410'/%3E%3Cpath d='M16 5 L19.5 12.5 L27 16 L19.5 19.5 L16 27 L12.5 19.5 L5 16 L12.5 12.5 Z' fill='%23f5c451'/%3E%3C/svg%3E"
    />
    <!-- Same type scale the hero and the post list read from — see the note
         at the top of type.css. -->
    <link rel="stylesheet" href="/assets/type.css" />
    <link rel="stylesheet" href="/assets/sky.css" />
    <link rel="stylesheet" href="/assets/article.css" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {/* Below the canonical, and safe here for the same reason it is not yet on
        the landing: this head pins no hashes. og:title is the bare frontmatter
        title, without the " — Rafael Uchoa" suffix the title element carries,
        because og:site_name already says whose site this is. */}
    <ShareMeta
      title={title}
      description={description}
      type="article"
      slug={slug}
      imageAlt={ogImageAlt(slug, imageAlt)}
      publishedTime={date}
    />
  </head>
  <body class="article-page">
    <Starfield />

    <main class="article">
      <nav class="article-nav" aria-label="Breadcrumb">
        <a href="/"><span aria-hidden="true">&#8592;</span> Rafael Uchoa</a>
      </nav>

      <header class="article-header">
        <h1 class="article-title">{title}</h1>
        <p class="article-meta">
          <time datetime={isoDate}>{readableDate}</time>
          <span class="sep" aria-hidden="true">&middot;</span>
          <span>{readingTime}</span>
        </p>
      </header>

      <article class="prose">
        <slot />
      </article>

      <!-- The tagline sits here rather than in the landing's footer, where it
           was cut for repeating the hero's opening line. An article has no
           hero, so this is the only place it appears on the page.

           It is a second copy of the sentence, the first being the landing's
           hero and <title>. Reworded in one place it will drift in the other. -->
      <footer class="article-footer">
        &copy; {new Date().getFullYear()} Rafael Uchoa
        <span class="sep" aria-hidden="true">&middot;</span>
        I build AI features where measurement decides what ships.
      </footer>
    </main>

    <!-- Same vendored GoatCounter beacon the landing uses, absolute-pathed
         because this page is served from /articles/<slug>/. -->
    <script
      is:inline
      data-goatcounter="https://uchoa-space.goatcounter.com/count"
      async
      src="/assets/count.js"></script>
  </body>
</html>
