  </nav>

</main>

<!-- Hero on top, writing below. The hero above is unchanged; this section is
     the only addition to the landing, and it sits outside <main> so the hero
     keeps the first screen to itself. It renders nothing while the posts
     collection is empty. -->
<PostList />

<!-- The tagline used to be repeated here. It now opens the hero, and saying
     it twice on one page reads as filler, so the footer is the copyright
     alone again. -->
<footer>
  <p class="copyright">&copy; <span id="year"></span> Rafael Uchoa</p>
</footer>

<script is:inline>
  document.getElementById('year').textContent = String(new Date().getFullYear());
</script>

<!-- GoatCounter (EUPL). No cookies and no personal data, so the page needs
     no consent banner. Vendored locally at assets/count.js (security audit
     item 5) instead of loading gc.zgo.at at runtime — a compromised CDN
     would otherwise get full script execution on this origin. The pageview
     endpoint stays GoatCounter's cloud (data-goatcounter below); only the
     script's own source moved same-origin. To update, re-fetch by hand from
     https://gc.zgo.at/count.js — it's small, stable, and ISC-licensed. -->
<script is:inline data-goatcounter="https://uchoa-space.goatcounter.com/count"
        async src="assets/count.js"></script>

</body>
