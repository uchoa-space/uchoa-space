---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import Starfield from '../components/Starfield.astro';
import ShareMeta from '../components/ShareMeta.astro';
import { DEFAULT_OG_IMAGE_ALT } from '../lib/og-image';

// The "Read blog" button points at #writing, which only exists while PostList
// renders. No posts, no anchor, so no button either.
const hasPosts = (await getCollection('posts')).length > 0;

// The shipped policy, unchanged, is the strict one. `astro dev` additionally
// needs to reach Vite's HMR websocket and to inject its own stylesheets, both
// of which the strict policy denies: the symptom is a console full of
// "Refused to apply a stylesheet" plus a broken `ws.send`, and the practical
// cost is that live reload silently stops working. These two relaxations exist
// only while import.meta.env.DEV is true, so the build keeps the policy the
// site is audited against.
const csp = [
  "default-src 'none'",
  // Two inline scripts, each pinned by hash: the hero-seen check in the head
  // and the year in the footer.
  "script-src 'self' 'sha256-8q7odu0pAI06OJ43B0BzOdsitJ8D2tXb8RjYwR3oDCk=' 'sha256-WeE/AL/NMnjV1YDqJ5wFGyJlLBoKJU2aMtor4SYQZn4='",
  `style-src 'self' 'sha256-Ze6o7k+Qon/F2pVdlU6zaaiO7TpNdwmgYAMtI+4q7nc='${import.meta.env.DEV ? " 'unsafe-inline'" : ''}`,
  "img-src 'self' data: https://uchoa-space.goatcounter.com",
  `connect-src https://uchoa-space.goatcounter.com${import.meta.env.DEV ? ' ws://localhost:* http://localhost:*' : ''}`,
  "base-uri 'none'",
  "form-action 'none'",
  "object-src 'none'",
].join('; ');
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Rafael Uchoa - I build AI features where measurement decides what ships.</title>
<meta name="description" content="Rafael Uchoa, engineer. LinkedIn and GitHub." />
<!-- The canonical this page lacked while the article layout had one, built the
     same way. Links here are hand-delivered and may carry a ?ref= channel tag;
     without this a scraper that follows one caches the same page as several
     distinct cards. -->
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
{/* Emits meta elements only, which is why it is safe in this head: the CSP
    below pins SHA-256 hashes of the inline style and script blocks, and an
    inline block arriving from a component would be unhashed and dropped. The
    policy itself does not change here. The PNG is same-origin and img-src
    'self' already covers it, and a card-rendering crawler fetches the image
    directly, so it is never subject to this page's policy at all.

    No slug, so the resolver returns the default card, and its alt is the one
    written from looking at that PNG rather than a second copy invented here. */}
{/* The lede is the title, not the name. og:site_name and the wordmark in the
    card image both already say whose site this is, so a title of "Rafael
    Uchoa" spent the most prominent line repeating them. It matters most on
    the LinkedIn feed surface, which drops the description entirely: that
    card now says what the person does rather than only who they are.

    The lede is moved up rather than copied up. Left in both, Slack and
    Discord would print the same sentence twice one line apart — invisible
    in the markup, obvious the moment a card renders.

    The description is written for Slack, which is where a link to this
    site actually gets forwarded, and Slack wins where clients conflict.
    Slack shows roughly 300 characters and renders title and description
    in full; X and WhatsApp cut somewhere around 90 to 125 and will
    visibly truncate this. That truncation is an accepted trade, not a
    defect — writing short enough for the tight clients would spend
    Slack's room to protect surfaces that matter less here.

    Every clause is taken from the intro paragraph further down this
    page, so the card asserts nothing the site does not already say. That
    is the constraint on editing it: a claim gets added to the landing
    first, and only then to the card. */}
<ShareMeta
  title="I build AI features where measurement decides what ships."
  description="Full-stack engineer since 2008; co-founded a real-time platform, 100,000+ users at 99.9% uptime. 2026 on RAG, agent runtimes and LLM evaluation."
  type="website"
  imageAlt={DEFAULT_OG_IMAGE_ALT}
/>
<meta name="color-scheme" content="dark" />
<!-- CSP (security audit item 4): deny-by-default, then allow only what the
     page actually uses — same-origin scripts/styles plus the one inline
     script by hash, the goatcounter beacon (sendBeacon + Image fallback
     both hit its host), and data: for the favicon. GitHub Pages can't set
     response headers, so frame-ancestors is intentionally omitted here —
     a meta CSP ignores it, browsers only honour it as a real header. -->
<meta http-equiv="Content-Security-Policy" content={csp} />
<!-- Inline data-URI favicon: a gold sparkle (matches the starfield motif) on
     the page's near-black. Keeps it a zero-request icon — see the deploy
     workflow note, a real file under assets/ wouldn't get published. -->
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%23030410'/%3E%3Cpath d='M16 5 L19.5 12.5 L27 16 L19.5 19.5 L16 27 L12.5 19.5 L5 16 L12.5 12.5 Z' fill='%23f5c451'/%3E%3C/svg%3E" />
<!-- The post list's styles, kept out of the hashed inline block below: adding a
     declaration there would change the bytes the CSP hashes and block the
     page's own stylesheet. A same-origin file is already allowed by
     style-src 'self', and unlike a bundled stylesheet it is a plain file in
     dev too, so nothing inline is ever injected here. -->
<!-- The hero's entrance is a guided first read, so it should happen once. On
     the way back from a post it would be four seconds of delay in front of
     something already read.

     This has to run before the body is painted, or the animation starts and
     then gets cancelled mid-way, which is worse than either outcome — hence
     an inline script here in the head rather than a module at the end. It
     carries is:inline for the same reason the blocks below do: Astro must
     leave the bytes alone, because script-src pins them by hash.

     sessionStorage, not localStorage: the guided read is an introduction, so
     it is worth repeating on a genuinely new visit, just not on every step of
     this one. If storage throws — private modes do — the animation simply
     plays, which is the harmless branch. -->
<script is:inline>
  try {
    if (sessionStorage.getItem('hero-seen')) document.documentElement.dataset.heroSeen = '';
    else sessionStorage.setItem('hero-seen', '1');
  } catch (e) {}
</script>
<!-- Type scale: sizes, weights, line-heights and letter-spacing shared with
     posts.css and article.css, so the hero, the post list and the article
     shell read from one ramp instead of each inventing its own numbers. -->
<link rel="stylesheet" href="assets/type.css" />
<link rel="stylesheet" href="assets/sky.css" />
<link rel="stylesheet" href="assets/a11y.css" />
{hasPosts && <link rel="stylesheet" href="assets/posts.css" />}
<!-- is:inline on this block and on the two script tags below is load-bearing,
     not a style choice. Without it Astro scopes and bundles the CSS into an
     external file and rewrites the inline JS, changing the very bytes the CSP
     above hashes and blocking the page's own stylesheet. See tasks/plan.md. -->
<style is:inline>
  /* ---------------------------------------------------------------
     Figma → code. Every colour below is a variable from the Figma
     file "Uchoa Space — Landing"; the button geometry is lifted
     from frame 8:23. The starfield is the SVG
     Figma exported. The wordmark is live text under a transform, not the
     exported outline — see the note on .wordmark below.
     --------------------------------------------------------------- */

  :root {
    --gold: #f5c451;
    --gold-dim: #a9803a;
    --gold-bright: #ffd77a; /* the hover gold, same one article.css uses on links */
    --text-on-gold: #17130a; /* warm near-black; pure black on gold reads harsh */
    --bg-page: #030410;
    --text-primary: #d8dae2;
    --text-secondary: #b3b8c6; /* supporting copy that must recede behind the lede */
    --text-footer: #7b8298; /* 5.34:1 on --bg-page — WCAG AA (was #565b6e, 3.03:1) */
  }

  * { box-sizing: border-box; }

  /* `height: 100%` on the body is a leftover from the single-screen landing.
     Now that the post list and the footer flow below the hero, it clamps the
     body's box to the first fold: everything past it overflows outside the
     box, and the body's own padding-bottom gets painted at the fold instead
     of after the footer. `min-height: 100dvh` below already does the job the
     100% was there for. */
  html { height: 100%; }

  body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 44px;
    margin: 0;
    padding: 0 16px 64px;
    min-height: 100dvh;
    overflow-x: hidden;
    background: var(--bg-page);
    color: var(--text-primary);
    font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* The starfield (Figma 7:7 / 8:24, exported as SVG) lives in
     assets/sky.css now that the article pages share it. */

  /* --- wordmark ---
     Live text, not an exported outline. The matrix is the one the original
     canvas used to rasterise the word (A=0.86, C=-0.16, D=1.04): condense
     to 86%, slant, stretch 4% taller. text-stroke hollows the letters out
     and drop-shadow puts the glow around that stroke — text-shadow would
     trace the invisible fill instead. --- */

  .wordmark {
    margin: 0;
    max-width: 100%;
    font-family: 'Arial Black', 'Helvetica Neue', Arial, sans-serif;
    font-weight: 900;
    font-size: clamp(56px, 22vw, 96px);
    line-height: 1.04;
    letter-spacing: 0.084em;
    text-align: center;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 2px var(--gold);
    transform: matrix(0.86, 0, -0.16, 1.04, 0, 0);
    filter:
      drop-shadow(0 0 7px rgba(245, 196, 81, 0.55))
      drop-shadow(0 0 20px rgba(245, 196, 81, 0.28));
  }

  .wordmark span { display: block; }

  /* --- statement: lede + intro ---
     The hero leads with the one sentence the whole site is about — the same
     line the <title> carries — and the bio sits under it as support, dimmer
     and smaller, so the two do not compete. They are grouped in one block
     because the body's 44/56px flex gap is the spacing between hero *parts*;
     these two are one part.

     The bio is a shortened version of the summary paragraph in a longer
     written CV kept outside this repository. It is no longer verbatim: the CV
     keeps the full stack list and the decision count, the hero keeps the three
     facts worth reading standing up. --- */

  .statement {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 42rem;
  }

  .lede {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--fs-lede);
    font-weight: var(--fw-medium);
    line-height: 1.35;
    text-align: center;
    text-wrap: balance;
  }

  .intro {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--fs-copy);
    font-weight: var(--fw-regular);
    line-height: var(--lh-copy);
    text-align: center;
  }

  /* --- marker underline ---
     A hand-drawn gold sweep under the one claim in the bio that is a number
     rather than an adjective. Two passes at different opacities, the way a
     real marker doubles back, drawn as an SVG data URI: `img-src 'self'
     data:` already covers it (same mechanism as the favicon above), so this
     needs no file and no CSP change. The URI itself is `--mark-underline` in
     assets/type.css, because the article's `.prose mark` wants the identical
     stroke and one of the two copies would sit inside this hashed block.

     preserveAspectRatio="none" lets it stretch to whatever width the phrase
     ends up being; only its length distorts, the thickness is vertical and
     survives. box-decoration-break: clone gives each line its own sweep if
     the phrase wraps on a narrow screen, instead of one box sliced in half
     across the two lines.

     The padding-bottom is what sets how far under the baseline the stroke
     sits: the background is pinned to the bottom of the box, so growing the
     box downward lowers the stroke. --- */

  .mark {
    background-color: transparent;
    color: inherit;
    background-image: var(--mark-underline);
    background-repeat: no-repeat;
    background-size: 100% 0.5em;
    background-position: 0 100%;
    padding-bottom: 0.3em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* --- link buttons (Figma component "Link Button", 6:16) --- */

  .links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: min(358px, 100%);
  }

  .links a,
  .links button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 14px 20px;
    height: 48px;
    width: 100%;
    border: 1px solid var(--gold-dim);
    border-radius: 10px;
    background: transparent;
    color: var(--gold);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    line-height: 1;
    font-family: inherit;
    letter-spacing: var(--ls-interactive);
    text-decoration: none;
    cursor: pointer;
    transition: background-color 120ms ease, border-color 120ms ease;
  }

  .links a:hover,
  .links button:hover {
    background: rgba(245, 196, 81, 0.1);
    border-color: var(--gold);
  }

  .links svg {
    width: 20px;
    height: 20px;
    flex: none;
    stroke: currentColor;
  }

  /* --- primary action ---
     A filled button among outlined ones: the design-system spelling of
     primary against secondary. The inversion is the whole of it — the fill
     takes the colour the border and the label had, and the label takes the
     page's ground.

     Only one of these can exist at a time. A second filled button would put
     two things first, which is the same as putting nothing first.

     It arrives outlined, like its two neighbours, and fills in only once the
     reader has been through everything and has nowhere left to go. That is
     the argument for the timing: the sweep is the page answering "so what do
     I do now", and it cannot answer before the question exists.

     These rules must stay after the `.links a` block above: same specificity,
     so source order is what decides. The icon needs no rule of its own, it is
     stroked with currentColor.

     The fill is painted as a gradient rather than a background-color so it
     can be swept: background-size goes from 0% to 100% width, growing from
     the left edge. On the element itself, with no pseudo-element and no
     clip-path — the two constructs that failed on the marker and were never
     explained. This is the same technique the marker's own stroke uses, which
     does work here.

     Resting state is the finished, filled button. The unfilled look lives
     only in the keyframe's `from`, held through the delay by `backwards`, so
     a CTA that never animates is simply a filled CTA.

     The entrance and the fill are one comma-separated `animation` list, and
     they have to stay that way. `animation` is a shorthand: a second
     declaration on this element replaces the list, it does not add to it.
     This selector is (0,2,0) and the entrance rule `.links > *` is (0,1,0),
     so this one wins the cascade whatever the source order — which is how
     the button once ended up with the fill and no entrance, fully present
     in the first painted frame while its two neighbours rose in. The two
     animations touch disjoint properties (hero-rise does opacity and
     transform, cta-fill does background-size and color), so composing them
     costs nothing. Adding a third here means extending this list. */

  .links .cta {
    background-color: transparent;
    background-image: linear-gradient(var(--gold), var(--gold));
    background-repeat: no-repeat;
    background-size: 100% 100%;
    border-color: var(--gold);
    color: var(--text-on-gold);
    animation:
      hero-rise 600ms var(--read-actions) ease-out backwards,
      cta-fill 700ms var(--read-cta) ease-out backwards;
  }

  /* Sets background-image, not the `background` shorthand: the shorthand
     would reset the gradient that is doing the filling. */
  .links .cta:hover {
    background-image: linear-gradient(var(--gold-bright), var(--gold-bright));
    border-color: var(--gold-bright);
  }

  @keyframes cta-fill {
    from {
      background-size: 0% 100%;
      color: var(--gold);
    }
  }

  /* Groups the wordmark + nav as the page's <main> landmark, and owns the
     first screen on its own: the hero keeps its full-viewport centring while
     the writing list flows below the fold. Centring lives here rather than on
     body because a centred flex container overflows in BOTH directions once
     its content is taller than the viewport, and the overflow above the top
     edge cannot be scrolled to — which clipped the wordmark. `safe` drops the
     centring instead of clipping when the hero alone is taller than the
     screen. */
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: safe center;
    min-height: 100dvh;
    gap: 44px;
  }

  /* --- entrance ---
     Each element animates *from* a state, never *to* one: with
     animation-fill-mode: backwards the element holds the `from` frame during
     its delay and then falls back to its own resting style, which is the
     visible one. Spelling it the other way round — opacity: 0 in the resting
     rule plus `forwards` — means anything that stops the animation from
     running leaves the hero blank, which is a bad trade for a decoration.

     This is paced as assisted reading, not as decoration. Each step appears
     only once there has been time to take in the one before it, so the order
     below is the order a reader is being walked through: the name, then the
     one sentence that says what I do, then the bio — which is a paragraph
     rather than a line, and where the marker carries the part that matters —
     and last the buttons.

     The variables are named for the step, not for a beat number, because the
     number that matters is "when does the reader get here". Each is absolute
     rather than relative to the previous one: reading time does not compose,
     and a chain of offsets hides how long the whole thing actually takes.

     The three buttons share one delay on purpose. They are alternatives, not
     a sequence — staggering them implied a priority between LinkedIn, GitHub
     and the blog that does not exist.

     (The marker's own sweep would belong just after --read-bio. It is static
     for now: animating it failed twice and the cause was never found.) */

  /* The whole scale was multiplied by 5/12 once the bio was measured to be
     the page's Largest Contentful Paint element (record:
     .preview/lcp-measurement.md): `backwards` holds it at opacity: 0 for the
     whole delay, and a browser does not count an element at opacity: 0 as
     painted, so --read-bio *is* the LCP time. The fade stays — it is part of
     the choreography, not decoration — so the delays move instead. 5/12 is
     the factor that puts --read-bio on 1000ms and happens to leave every
     other step on a whole millisecond, so the gaps keep their 3 : 5 : 4
     proportion exactly and the sequence still reads as a sequence. */
  :root {
    --read-name: 0ms;
    --read-line: 375ms;
    --read-bio: 1000ms;
    --read-actions: 1500ms;
    /* The buttons finish arriving at 1500 + 600. This waits past that, long
       enough for the reader to have run out of page. */
    --read-cta: 2250ms;
  }

  @keyframes hero-fade {
    from { opacity: 0; }
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(10px); }
  }

  /* Opacity only. This element's resting transform is the matrix that
     condenses and slants the letters, and a translate in the keyframe would
     replace it rather than compose with it. */
  .wordmark {
    animation: hero-fade 700ms var(--read-name) ease-out backwards;
  }

  .lede {
    animation: hero-rise 600ms var(--read-line) ease-out backwards;
  }

  .intro {
    animation: hero-rise 600ms var(--read-bio) ease-out backwards;
  }

  .links > * {
    animation: hero-rise 600ms var(--read-actions) ease-out backwards;
  }

  /* Seen already this session (the script in the head sets this): drop the
     animations and every element falls back to its resting style, which is
     the finished one. Same escape hatch as prefers-reduced-motion. */
  [data-hero-seen] .wordmark,
  [data-hero-seen] .lede,
  [data-hero-seen] .intro,
  [data-hero-seen] .links > *,
  /* Listed on its own because `.links .cta` is (0,2,0): a selector that only
     matched it via `.links > *` would have to out-specify it to switch its
     animations off, and specificity is exactly what broke this rule once. */
  [data-hero-seen] .links .cta {
    animation: none;
  }

  :focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  footer {
    text-align: center;
  }

  .copyright {
    margin: 0;
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    color: var(--text-footer);
  }

  /* Figma's desktop frame (8:23): one-line wordmark, links in a row. */
  @media (min-width: 640px) {
    body { gap: 56px; padding: 0 80px 64px; }
    main { gap: 56px; }
    .wordmark {
      font-size: clamp(64px, 9.2vw, 124px);
      -webkit-text-stroke-width: 2.5px;
    }
    .wordmark span { display: inline; }
    /* Three 220px buttons plus their gaps need 684px, more than the viewport
       has at this breakpoint once body's 80px side padding is taken out, so
       the row wraps rather than overflowing. */
    .links { flex-direction: row; flex-wrap: wrap; justify-content: center; width: auto; }
    .links a, .links button { width: 220px; }
  }

  html { scroll-behavior: smooth; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .links a, .links button { transition: none; }
    /* Removing the animation leaves each element on its resting style, which
       is the finished one — the hero is simply already there.

       `.links .cta` is named explicitly for the same reason it is named in
       the [data-hero-seen] list above: it is (0,2,0) and `.links > *` is
       (0,1,0), so without it the button kept animating for a reader who had
       asked the operating system to stop motion. */
    .wordmark, .lede, .intro, .links > *, .links .cta { animation: none; }
  }
</style>
</head>
<body>

<!-- First focusable element on the page, ahead of the profile links. Its
     styles are in assets/a11y.css rather than the hashed block below, for the
     same reason the starfield's are in sky.css: the article pages need the
     identical rules, and a same-origin file is one copy instead of two. -->
<a class="skip-link" href="#content">Skip to content</a>

<Starfield />

<main id="content" tabindex="-1">
  <h1 class="wordmark"><span>Rafael</span> <span>Uchoa</span></h1>

  <div class="statement">
    <p class="lede">I build AI features where measurement decides what ships.</p>
    <p class="intro">Full-stack engineer since 2008. Co-founded and ran a real-time platform for a decade (<mark class="mark">100,000+ users, 99.9% uptime</mark>). Spent 2026 on full-time AI engineering R&amp;D: RAG, agent runtimes, and LLM evaluation.</p>
  </div>

  <!-- CTA click tracking: count.js binds a listener to every element carrying
       data-goatcounter-click (see assets/count.js, bind_events), so this needs
       no extra script and leaves the CSP hash untouched. The clicks arrive as
       events, listed alongside pageviews in the dashboard. An explicit title is
       given because the fallback is the element's innerHTML — here, raw SVG. -->
  <nav class="links" aria-label="Profiles and writing">
    <a href="https://www.linkedin.com/in/uchoaaa" rel="me noopener" target="_blank"
       data-goatcounter-click="cta-linkedin" data-goatcounter-title="CTA: LinkedIn">
      <!-- lucide "linkedin" (ISC) — Figma 6:6 -->
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M16 8C17.5913 8 19.1174 8.63214 20.2426 9.75736C21.3679 10.8826 22 12.4087 22 14V21H18V14C18 13.4696 17.7893 12.9609 17.4142 12.5858C17.0391 12.2107 16.5304 12 16 12C15.4696 12 14.9609 12.2107 14.5858 12.5858C14.2107 12.9609 14 13.4696 14 14V21H10V14C10 12.4087 10.6321 10.8826 11.7574 9.75736C12.8826 8.63214 14.4087 8 16 8Z"/>
        <path d="M6 9H2V21H6V9Z"/>
        <path d="M4 6C5.10457 6 6 5.10457 6 4C6 2.89543 5.10457 2 4 2C2.89543 2 2 2.89543 2 4C2 5.10457 2.89543 6 4 6Z"/>
      </svg>
      LinkedIn
    </a>
    <a href="https://github.com/uuchoaa" rel="me noopener" target="_blank"
       data-goatcounter-click="cta-github" data-goatcounter-title="CTA: GitHub">
      <!-- lucide "github" (ISC) — Figma 6:10 -->
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 22V18C15.1391 16.7473 14.7797 15.4901 14 14.5C17 14.5 20 12.5 20 9C20.08 7.75 19.73 6.52 19 5.5C19.28 4.35 19.28 3.15 19 2C19 2 18 2 16 3.5C13.36 3 10.64 3 8 3.5C6 2 5 2 5 2C4.7 3.15 4.7 4.35 5 5.5C4.27 6.52 3.92 7.75 4 9C4 12.5 7 14.5 10 14.5C9.61 14.99 9.32 15.55 9.15 16.15C8.98 16.75 8.93 17.38 9 18V22"/>
        <path d="M9 18C4.49 20 4 16 2 16"/>
